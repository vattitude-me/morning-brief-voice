# CPU image for the Chatterbox-Turbo voice service.
#
# Use this on any machine without an NVIDIA GPU — including Docker Desktop on Apple
# Silicon, where the CUDA image is useless and MPS is not available inside a container.
# Rendering is slower than a GPU (and slower than running natively on Apple Silicon,
# which can use MPS), but it is fully self-contained: a faithful stand-in for a cloud
# host, and the image the local web app talks to.
#
#   docker build -f Dockerfile.cpu -t morning-brief-voice:cpu .
#   docker run -p 8090:8090 -v voice-models:/models \
#     -v "$PWD/data/voices:/app/data/voices" morning-brief-voice:cpu
#
# Or just `docker compose up --build`.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models \
    VOICE_DIR=/app/data/voices \
    VOICE_CORS_ORIGINS=*

# libsndfile for soundfile; ffmpeg for librosa inputs and the MP3 fallback;
# build-essential + git because a few Chatterbox dependencies are source-only.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libsndfile1 ffmpeg build-essential git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY api ./api
COPY turbo_voice ./turbo_voice
# Install CPU-only torch first so pip does not pull the multi-gigabyte CUDA wheels,
# then the service itself (torch is already satisfied, so it is left alone).
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch torchaudio \
 && pip install -e .

# One worker: the model lives in memory and generate() is serialised behind a lock.
EXPOSE 8090
CMD ["uvicorn", "--app-dir", ".", "api.app:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
